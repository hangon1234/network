#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

start_service() {
    # Ensure system time is synchronized before starting Xray (critical for VLESS REALITY handshake)
    ntpd -q -n -p ntp.aliyun.com -p time.cloudflare.com -p pool.ntp.org >/dev/null 2>&1 || true

    procd_open_instance
    procd_set_param command /usr/bin/xray run -c /etc/xray/config.json
    procd_set_param respawn
    procd_close_instance
}

