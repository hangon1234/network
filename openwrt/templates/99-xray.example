#!/bin/sh

set -e

WIFI_SSID='REPLACE_WITH_WIFI_SSID'
WIFI_PASSWORD='REPLACE_WITH_WIFI_PASSWORD'
ROOT_PASSWORD_HASH='REPLACE_WITH_ROOT_PASSWORD_HASH'
LAN_IP='REPLACE_WITH_LAN_IP'

set_lan_defaults() {
    if [ -n "$LAN_IP" ]; then
        uci -q set network.lan.ipaddr="$LAN_IP"
        uci -q set network.lan.netmask="255.255.255.0"
        uci -q commit network
    fi
}

set_xray_routing() {
    # Create a named network interface for the Xray TUN device
    uci -q delete network.xray || true
    uci -q set network.xray='interface'
    uci -q set network.xray.proto='none'
    uci -q set network.xray.device='xray0'

    # Route table 100 via xray0 for transparent proxy
    uci -q add network route
    uci -q set network.@route[-1].interface='xray'
    uci -q set network.@route[-1].target='0.0.0.0'
    uci -q set network.@route[-1].netmask='0.0.0.0'
    uci -q set network.@route[-1].table='100'

    uci -q add network route6
    uci -q set network.@route6[-1].interface='xray'
    uci -q set network.@route6[-1].target='::/0'
    uci -q set network.@route6[-1].table='100'

    # Policy routing: forward client traffic from LAN/Wi-Fi to table 100 (xray0)
    # Router's local traffic stays on main table (WAN) preventing routing loops
    uci -q add network rule
    uci -q set network.@rule[-1].in='lan'
    uci -q set network.@rule[-1].lookup='100'
    uci -q set network.@rule[-1].priority='1000'

    uci -q add network rule6
    uci -q set network.@rule6[-1].in='lan'
    uci -q set network.@rule6[-1].lookup='100'
    uci -q set network.@rule6[-1].priority='1000'

    uci -q commit network
}

set_xray_firewall() {
    # Include xray in firewall wan zone to allow LAN/Wi-Fi forwarding and NAT/masquerade
    local wan_zone
    wan_zone="$(uci -q show firewall | grep "name='wan'" | head -n1 | cut -d. -f1,2)"
    if [ -n "$wan_zone" ]; then
        uci -q add_list "${wan_zone}.network=xray"
        uci -q commit firewall
    fi
}

set_wireless_defaults() {
    [ -f /etc/config/wireless ] || wifi config

    local radios ifaces radio iface

    radios="$(uci -q show wireless | sed -n "s/^\(wireless\.[^=]*\)=wifi-device$/\1/p")"
    ifaces="$(uci -q show wireless | sed -n "s/^\(wireless\.[^=]*\)=wifi-iface$/\1/p")"

    for radio in $radios; do
        uci -q set "${radio}.disabled=0"
        uci -q set "${radio}.country=KR"
    done

    for iface in $ifaces; do
        uci -q set "${iface}.disabled=0"
        uci -q set "${iface}.ssid=${WIFI_SSID}"
        uci -q set "${iface}.encryption=sae-mixed"
        uci -q set "${iface}.key=${WIFI_PASSWORD}"
        uci -q set "${iface}.ieee80211w=1"
    done

    uci -q commit wireless
}

set_root_password() {
    if [ -n "$ROOT_PASSWORD_HASH" ] && [ -f /etc/shadow ]; then
        sed -i "s|^root:[^:]*:|root:${ROOT_PASSWORD_HASH}:|" /etc/shadow
    fi
}

set_dhcp_defaults() {
    # Distribute Cloudflare/Google DNS to LAN/Wi-Fi clients (queries go through xray0 tunnel)
    # Router itself keeps using WAN ISP DNS for initial domain resolution (e.g. duckdns.org)
    uci -q delete dhcp.lan.dhcp_option || true
    uci -q add_list dhcp.lan.dhcp_option='6,1.1.1.1,8.8.8.8'
    uci -q commit dhcp
}

set_system_defaults() {
    # Configure reliable NTP servers (including Alibaba NTP for fast sync in China)
    uci -q delete system.ntp.server || true
    uci -q add_list system.ntp.server='ntp.aliyun.com'
    uci -q add_list system.ntp.server='time.cloudflare.com'
    uci -q add_list system.ntp.server='time.google.com'
    uci -q add_list system.ntp.server='pool.ntp.org'
    uci -q commit system

    /etc/init.d/sysntpd restart || true
    ntpd -q -n -p ntp.aliyun.com -p time.cloudflare.com -p pool.ntp.org >/dev/null 2>&1 || true
}

set_wireless_defaults
set_root_password
set_lan_defaults
set_xray_routing
set_xray_firewall
set_dhcp_defaults
set_system_defaults

if [ -f /etc/init.d/xray ]; then
    # Inject GOMAXPROCS=1 and nice priority into /etc/init.d/xray procd service
    sed -i 's|procd_set_param command "$PROG" run|procd_set_param env GOMAXPROCS=1\n\tprocd_set_param nice 19\n\tprocd_set_param command "$PROG" run|g' /etc/init.d/xray 2>/dev/null || true
    /etc/init.d/xray enable || true
    /etc/init.d/xray restart || true
fi

wifi reload >/dev/null 2>&1 || wifi >/dev/null 2>&1 || true

exit 0
